# 공개 URL (끝에 슬래시 없음)
VITE_SITE_URL=https://catch-jebi.vercel.app
# Kakao Developers > 플랫폼 키 > JavaScript 키 (카톡 공유)
VITE_KAKAO_JS_KEY=
# Kakao Developers > 플랫폼 키 > REST API 키 (카카오 로그인 client_id). 둘 다 같은 값
VITE_KAKAO_REST_KEY=
KAKAO_REST_API_KEY=
# Google Cloud > 인증 > 클라이언트 > 웹 애플리케이션 클라이언트 ID (Google 로그인, 시크릿 불필요)
VITE_GOOGLE_CLIENT_ID=
# 콘솔 REST API 키 카드에서 "카카오 로그인 클라이언트 시크릿 활성화" 를 켰을 때만 (서버 전용)
KAKAO_CLIENT_SECRET=
# Supabase > Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 서버 전용 (api/, supabase functions). 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=
# Umami Cloud
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
