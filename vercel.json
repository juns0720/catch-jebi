{
  "rewrites": [
    { "source": "/c", "destination": "/api/c" },
    { "source": "/challenge", "destination": "/challenge/index.html" },
    { "source": "/m", "destination": "/m/index.html" }
  ],
  "headers": [
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
